# Postgres (Neon). Use the pooled connection string.
DATABASE_URL=

# Vercel Blob, for the page photos
BLOB_READ_WRITE_TOKEN=

# OpenRouter, for transcription.
# Before the first call, turn on the account setting that restricts routing to
# providers that do not train on your input and output — what you are sending
# is a photograph of a personal letter.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Clerk, guards /admin.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/admin/sign-in

# Who is allowed in, as a comma-separated list of Clerk user ids.
#
# Signing in is not being allowed in. An empty list denies everyone, which is
# deliberate: this fails closed, so a forgotten value locks you out rather
# than letting a stranger in.
#
# Your id is in the Clerk dashboard under Users once you have signed in once
# (it starts with `user_`). The sign-in page does not show it, because that
# page is public. A Clerk development instance and a production one issue
# different ids, so this has to be set twice: here, and again wherever you
# deploy.
ADMIN_USER_IDS=

# Local escape hatch, honoured only outside production. `1` opens /admin
# without a session so you can work before Clerk exists; the flag is never
# read at all in a production build.
DEV_ADMIN_BYPASS=

# Base URL, used for OG images
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Where "write back" at the end of a letter goes.
# Not in the repository: an address on a public page gets harvested eventually,
# and an env var is easier to change than a form. Leave it empty and the button
# does not render, rather than rendering a broken mailto:.
WRITE_BACK_EMAIL=
