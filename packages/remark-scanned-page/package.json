{
  "name": "remark-scanned-page",
  "version": "0.1.0",
  "description": "Publish a scanned page with a synchronised transcription and an accessible fallback. Colour highlights live inside the markdown as directives.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles/scanned-page.css": "./styles/scanned-page.css",
    "./styles/palette.css": "./styles/palette.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "keywords": [
    "remark",
    "remark-plugin",
    "markdown",
    "directive",
    "highlight",
    "mark",
    "scanned",
    "handwriting",
    "transcription",
    "accessibility"
  ],
  "dependencies": {
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.0",
    "remark-directive": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.0.0",
    "unified": "^11.0.0",
    "unist-util-visit": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/mdast": "^4.0.0",
    "@types/react": "^19",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./styles/scanned-page.css": "./styles/scanned-page.css",
      "./styles/palette.css": "./styles/palette.css"
    }
  }
}
